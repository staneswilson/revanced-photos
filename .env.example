# =============================================================
# Google Photos ReVanced Pipeline — Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to git.

# --- Required: GitHub API ---
# Avoids rate limiting (60 req/hr anonymous → 5000 req/hr authenticated)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Required: APK Signing ---
# Your keystore as a Base64 string (see SETUP.md for how to generate)
KEYSTORE_BASE64=

# The key alias inside the keystore
KEY_ALIAS=revanced

# Keystore password
KEY_STORE_PASS=changeme

# Key-specific password (often same as KEY_STORE_PASS)
KEY_PASS=changeme

# --- Optional: Version Pinning ---
# Pin a specific Google Photos version (e.g. 6.91.0.636766573)
# If unset, the pipeline fetches the latest available from APKPure
# GPHOTOS_VERSION=6.91.0.636766573

# --- Optional: Skip Magisk Module Build ---
# Set to 'true' to skip building the Magisk flashable zip
# SKIP_MAGISK=true
